# データベース
DATABASE_URL="postgresql://postgres:password@localhost:5432/freelance_db?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here-min-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"

# Stripe (決済)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# 環境
NODE_ENV="development"

# オプション：Redis（キャッシュ・セッション）
REDIS_URL="redis://localhost:6379"

# オプション：S3/Cloudflare R2（ファイルストレージ）
S3_BUCKET="your-bucket-name"
S3_REGION="auto"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"
S3_ENDPOINT="https://your-account.r2.cloudflarestorage.com"

# オプション：メール送信（Resend/SendGrid）
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@yourdomain.com"
